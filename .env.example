# Copy to .env for local development. Names only, never real values.
PORT=3000

# 1 runs without Buffer: fake people and fake answers. Refused in production.
BUFFER_MOCK=

# From publish.buffer.com/settings/api. Use the dev app client locally, never the production one.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must match a redirect URI registered on the app client, character for character.
BUFFER_REDIRECT_URI=https://localhost:3000/callback

# At least 32 characters: openssl rand -hex 32
SESSION_SECRET=

# Copy to .env for local development. Names only, never real values.
PORT=3000

# 1 runs without Buffer: fake people and fake answers. Refused in production.
BUFFER_MOCK=

# From publish.buffer.com/settings/api. Use the dev app client locally, never the production one.
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
# Must match a redirect URI registered on the app client, character for character.
BUFFER_REDIRECT_URI=https://localhost:3000/callback

# At least 32 characters each, and different: openssl rand -hex 32
SESSION_SECRET=
# Encrypts the Buffer tokens in the database. Changing it signs everyone out.
TOKEN_KEY=

# The database name is part of the URI. npm run db starts MongoDB locally.
MONGODB_URI=mongodb://localhost:27017/chorus

# off pauses new Choruses (joining still works), so a big wave gets Buffer's whole daily API limit.
CHORUS_CREATE=

# Vercel sends it to /api/cleanup, the daily cleanup. Any long random value: openssl rand -hex 32
CRON_SECRET=

# "Draft with AI". Without a key the button doesn't show; AI_DRAFTS=off hides it even with one.
# In mock mode the AI is fake too, unless a key is set: then the fake people get the real AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# none, minimal, low (the default), medium or high. More thinking: slower and more tokens.
OPENAI_REASONING=
AI_DRAFTS=
# 1 prints the AI's instructions, input and response in the server log. Never in production.
AI_DEBUG=
